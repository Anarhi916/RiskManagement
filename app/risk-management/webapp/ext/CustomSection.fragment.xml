<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  
    <Table id="todosTable"
           items="{
             path: 'todo>/todos',
             length: 5
           }"
           inset="false"
           growing="false">
      <headerToolbar>
        <Toolbar>
          <Title text="Tasks (first 5)" level="H4" />
        </Toolbar>
      </headerToolbar>

      <columns>
        <Column>
          <Text text="Task" />
        </Column>
        <Column>
          <Text text="Status" />
        </Column>
      </columns>

      <items>
        <ColumnListItem>
          <cells>
            <Text text="{todo>title}" />
            <Text text="{= ${todo>completed} ? 'Done' : 'Pending' }" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
</core:FragmentDefinition>